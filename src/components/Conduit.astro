---
// The conduit: one line of light from the singularity down through every section (flow lane).
// Geometry and motion live in src/scripts/conduit.ts; this markup is the overlay it draws into.
// The overlay is sized and filled by the script; markup holds only the stable structure.
// The page field (flow-field.ts) is the fixed canvas behind every section, rendered here so the
// page composition in index.astro stays untouched (it is the first child of main, under the content).
import '../styles/flow.css';
---

<canvas class="flow-field" aria-hidden="true"></canvas>
<div class="conduit" aria-hidden="true">
  <svg xmlns="http://www.w3.org/2000/svg" focusable="false">
    <defs>
      <filter id="cd-soft" x="-10%" y="-10%" width="120%" height="120%">
        <feGaussianBlur stdDeviation="3" />
      </filter>
      <filter id="cd-bloom" x="-150%" y="-150%" width="400%" height="400%">
        <feGaussianBlur stdDeviation="2.5" />
      </filter>
      <!-- Section tops fade the line in (conduit.ts fills .cd-fade per layout); the gradient runs top to bottom. -->
      <linearGradient id="cd-fade-in" x1="0" y1="0" x2="0" y2="1">
        <stop class="cd-fade-0" offset="0" />
        <stop offset="1" stop-color="#fff" />
      </linearGradient>
      <!-- Each node is a soft halo; the stop colours follow the theme through flow.css. -->
      <radialGradient id="cd-halo-fill">
        <stop class="cd-halo-0" offset="0" />
        <stop class="cd-halo-1" offset="1" />
      </radialGradient>
      <!-- Section eyebrows are knocked out of the line (conduit.ts fills .cd-cut per layout) so no stroke crosses text. -->
      <mask id="cd-cut" maskUnits="userSpaceOnUse">
        <rect class="cd-cut-field" x="0" y="0" width="100%" height="100%" fill="#fff" />
        <g class="cd-fade"></g>
        <g class="cd-cut"></g>
      </mask>
    </defs>
    <g mask="url(#cd-cut)">
      <path class="cd-glow" fill="none" filter="url(#cd-soft)" />
      <path class="cd-core" fill="none" />
      <g class="cd-packets" filter="url(#cd-soft)"></g>
    </g>
    <g class="cd-nodes"></g>
    <circle class="cd-head-glow" r="5" filter="url(#cd-bloom)" />
    <circle class="cd-head" r="1.4" />
  </svg>
</div>

<script>
  import '../scripts/flow-field';
  import '../scripts/conduit';
</script>
