---
import { GITHUB_PROFILE, MAYA2C_REPO, MAYA2C_SITE, SOCIALS } from '../data/content';
import SocialIcon from './SocialIcon.astro';

// Source of this site. Public, so a visitor can read exactly what they are looking at.
const SITE_REPO = 'https://github.com/EricWijesinghe/eric-site';
// Computed when the site is built, in UTC, so the stamp matches the deployed artifact.
const built = new Date();
const builtDate = built.toISOString().slice(0, 10);
const year = built.getUTCFullYear();

const SECTIONS = [
  { label: 'About', href: '#about' },
  { label: 'Projects', href: '#projects' },
  { label: 'Skills', href: '#skills' },
  { label: 'Contact', href: '#contact' },
] as const;
const SOURCES = [
  { label: 'GitHub profile', href: GITHUB_PROFILE },
  { label: 'Maya2C site', href: MAYA2C_SITE },
  { label: 'Maya2C repository', href: MAYA2C_REPO },
  { label: 'Source of this site', href: SITE_REPO },
] as const;
---

<footer class="site-foot" aria-labelledby="foot-name">
  <div class="wrap foot-grid">
    <div class="foot-id">
      <p class="foot-name" id="foot-name">Eric Wijesinghe</p>
      <p class="foot-line">Rust developer and security researcher. Creator of Maya2C, a post-quantum Layer-1 blockchain in development.</p>
      <ul class="foot-social" aria-label="Social profiles">
        {SOCIALS.map((s) => (
          <li>
            <a href={s.href} rel="me noopener" target="_blank" aria-label={s.label} title={s.label}>
              <SocialIcon name={s.icon} />
            </a>
          </li>
        ))}
      </ul>
    </div>

    <nav class="foot-col" aria-label="Footer">
      <p class="foot-head">Site</p>
      <ul>
        {SECTIONS.map((s) => <li><a href={s.href}>{s.label}</a></li>)}
      </ul>
    </nav>

    <nav class="foot-col" aria-label="Links">
      <p class="foot-head">Links</p>
      <ul>
        {SOURCES.map((s) => (
          <li><a href={s.href} rel="noopener" target="_blank">{s.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>

  <div class="wrap foot-base">
    <p class="foot-meta">
      <span>© {year} Eric Wijesinghe</span>
      <span aria-hidden="true">·</span>
      <span>Built with Astro · hosted on Cloudflare</span>
      <span aria-hidden="true">·</span>
      <span>Built <time datetime={builtDate}>{builtDate}</time></span>
    </p>
    <a class="foot-top" href="#top">Back to top <span aria-hidden="true">↑</span></a>
  </div>
</footer>

<style>
  /* No top edge and no solid fill: the page field runs straight through, so the footer has no seam. */
  .site-foot {
    position: relative;
    margin-top: clamp(64px, 10vw, 120px);
    padding: clamp(40px, 6vw, 64px) 0 calc(24px + env(safe-area-inset-bottom));
  }
  .foot-grid {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 32px 40px;
  }
  .foot-name {
    margin: 0 0 8px;
    font: 800 clamp(1.3rem, 2.4vw, 1.6rem) / 1.1 var(--font-display);
    letter-spacing: -0.02em;
    color: var(--text);
  }
  .foot-line {
    max-width: 30rem;
    margin: 0 0 18px;
    color: var(--text-dim);
    font-size: 0.95rem;
  }
  .foot-social {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Soft chips, theme-aware: tinted in dark, pale in light; the icon is the accent. No edge. */
  .foot-social a {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--sig-radius);
    background: var(--ctl-bg);
    color: var(--accent);
    transition: color 0.2s, background-color 0.2s;
  }
  .foot-social a:hover,
  .foot-social a:focus-visible {
    color: var(--text);
    background: var(--ctl-bg-hover);
  }
  .foot-head {
    margin: 0 0 10px;
    color: var(--text-dim);
    font: 500 0.75rem/1.4 var(--font-mono);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .foot-col ul {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .foot-col a {
    display: inline-flex;
    align-items: center;
    min-width: var(--tap);
    min-height: var(--tap);
    color: var(--text);
    font-size: 0.95rem;
    text-decoration: none;
  }
  .foot-col a:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .foot-base {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    margin-top: clamp(32px, 5vw, 56px);
    padding-top: 0;
  }
  .foot-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 10px;
    margin: 0;
    color: var(--text-dim);
    font: 500 0.75rem/1.5 var(--font-mono);
    letter-spacing: 0.08em;
  }
  .foot-top {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 16px;
    border-radius: var(--sig-radius);
    background: var(--ctl-bg);
    color: var(--text-dim);
    font: 500 0.75rem/1 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    transition: color 0.2s, background-color 0.2s;
  }
  .foot-top:hover {
    color: var(--accent);
    background: var(--ctl-bg-hover);
  }
  @media (max-width: 720px) {
    .foot-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
    .foot-id {
      grid-column: 1 / -1;
    }
    /* One item per line on phones: a dot separator at a wrap point reads as a stray mark. */
    .foot-meta {
      flex-direction: column;
      gap: 4px;
    }
    .foot-meta > [aria-hidden='true'] {
      display: none;
    }
  }
</style>
