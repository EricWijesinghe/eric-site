---
// The whole page answers his charge and release: glyphs gather into an orbit around his torso, fall into him and
// leave from him (src/scripts/energy-overlay.ts), and everything around him trembles while he holds
// (src/scripts/energy-shake.ts). Decoration only.
import '../styles/energy.css';
---

<canvas class="energy-overlay" data-energy aria-hidden="true"></canvas>

<script>
  import { whenIdle } from '../scripts/idle';
  import type { Box } from '../scripts/energy-orbit';

  // The engine reports his figure's box once per layout, possibly before the lazy modules below have loaded,
  // so the listener lives here and they read the latest box from it.
  let fig: Box | null = null;
  window.addEventListener('m2c:layout', (e) => { fig = (e as CustomEvent<{ fig: Box }>).detail.fig; });
  const figure = (): Box | null => fig;

  const c = document.querySelector<HTMLCanvasElement>('[data-energy]');
  if (c) {
    whenIdle(() => {
      Promise.all([import('../scripts/energy-overlay'), import('../scripts/energy-shake')])
        .then(([{ mountEnergy }, { mountShake }]) => {
          const shake = mountShake(figure);
          mountEnergy(c, figure, (power) => shake.jolt(power));
        })
        // decoration: without it the hero still charges and releases on its own
        .catch((err: unknown) => console.warn('Energy overlay unavailable:', err));
    });
  }
</script>
