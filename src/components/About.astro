---
import { ABOUT_PARAGRAPHS, STATS } from '../data/content';
---

<section id="about" aria-labelledby="about-title">
  <div class="wrap">
    <p class="section-label" data-reveal><span>01</span> about</p>
    <h2 class="section-title" id="about-title" data-reveal>Who I am</h2>
    <div class="about-grid">
      <div class="about-text" data-reveal>
        {ABOUT_PARAGRAPHS.map((p) => <p>{p}</p>)}
      </div>
      <ul class="stat-grid" data-reveal>
        {
          STATS.map((s) => (
            <li class="stat-card" data-tilt>
              <div class="stat-number">{s.value}</div>
              <div class="stat-label">{s.label}</div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
