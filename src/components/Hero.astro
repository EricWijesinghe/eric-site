---
import { ROLES } from '../data/content';
---

<section class="hero" id="top" aria-labelledby="hero-title" data-gl="hero">
  <div class="hero-poster" aria-hidden="true">
    <span class="hero-floor"></span>
    <span class="hero-hex"></span>
  </div>
  <canvas class="gl-canvas" aria-hidden="true"></canvas>
  <div class="hero-vignette" aria-hidden="true"></div>
  <div class="wrap hero-copy">
    <p class="eyebrow"><span class="pulse-dot" aria-hidden="true"></span>now building maya2c.dev — post-quantum L1</p>
    <h1 id="hero-title"><span class="h1-line">Eric</span> <span class="h1-line h1-accent">Wijesinghe</span></h1>
    <ul class="hero-roles" aria-label="Roles">
      {ROLES.map((r) => <li>{r}</li>)}
    </ul>
    <p class="hero-bio">
      Building systems at the intersection of <strong>Rust</strong>, cryptography, cybersecurity, and AI.
      Creator of <strong>Maya2C</strong>, a post-quantum Layer-1 blockchain with DAG-BFT finality.
    </p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="#projects">View projects</a>
      <a class="btn btn-ghost" href="https://maya2c.dev" rel="noopener noreferrer" target="_blank">maya2c.dev <span aria-hidden="true">↗</span><span class="visually-hidden"> (opens in a new tab)</span></a>
    </div>
  </div>
  <a class="scroll-cue" href="#about"><span class="scroll-line" aria-hidden="true"></span><span class="visually-hidden">Scroll to about</span></a>
</section>
