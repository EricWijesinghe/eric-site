---
import { CONTACT_TEXT, FEATURED_PROJECT, MAYA2C_DISCUSSIONS, SOCIALS } from '../data/content';
import SocialIcon from './SocialIcon.astro';
import '../styles/sections-signal.css';
import '../styles/contact-globe.css';
import '../styles/finale-contact.css';
---

<!-- One unboxed stage: the copy on the left, the signal globe on the right (src/scripts/contact-globe.ts).
     The three profile links under the globe are its ground stations; each one has a satellite. -->
<section id="contact" aria-labelledby="contact-title">
  <canvas class="fin-globe-canvas" data-globe aria-hidden="true"></canvas>
  <div class="wrap fin-copy">
    <p class="section-label" data-reveal><span>05</span> contact</p>
    <h2 class="section-title" id="contact-title" data-reveal>Work together</h2>
    <p class="fin-text" data-reveal>{CONTACT_TEXT}</p>
    <div class="fin-cta" data-reveal>
      <a class="btn btn-primary" data-uplink href={MAYA2C_DISCUSSIONS} rel="noopener noreferrer" target="_blank">Start a discussion <span aria-hidden="true">↗</span><span class="visually-hidden"> (opens in a new tab)</span></a>
    </div>
  </div>
  <div class="fin-orb" data-ring={FEATURED_PROJECT.name}>
    <div class="fin-sphere">
      <button type="button" class="globe-hit" aria-label="Signal globe: drag or use the arrow keys to turn it, press to send a pulse around it" aria-describedby="globe-desc"></button>
      <p id="globe-desc" class="visually-hidden">A dotted globe turning in depth, with arcs of light between places, the name {FEATURED_PROJECT.name} circling it in binary, and one satellite above each profile link below it.</p>
    </div>
    <ul class="fin-stations" aria-label="Social profiles">
      {
        SOCIALS.map((s) => (
          <li>
            <a href={s.href} rel="me noopener noreferrer" target="_blank" aria-label={`${s.label} (opens in a new tab)`}>
              <SocialIcon name={s.icon} />
              <span>{s.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  import { mountGlobe } from '../scripts/contact-globe';

  // Lazy: the globe is built only when the section comes within 300px of the viewport.
  const canvas = document.querySelector<HTMLCanvasElement>('[data-globe]');
  const hit = document.querySelector<HTMLButtonElement>('#contact .globe-hit');
  const cta = document.querySelector<HTMLElement>('#contact [data-uplink]');
  const orb = document.querySelector<HTMLElement>('#contact .fin-orb');
  if (canvas && hit && cta && orb) {
    const io = new IntersectionObserver(
      (es) => {
        if (!es.some((e) => e.isIntersecting)) return;
        io.disconnect();
        const stations = [...orb.querySelectorAll<HTMLElement>('.fin-stations a')];
        mountGlobe(canvas, { hit, cta, stations, ring: orb.dataset.ring ?? '' });
      },
      { rootMargin: '300px 0px' },
    );
    io.observe(canvas);
  }
</script>
