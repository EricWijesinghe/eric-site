---
import { FEATURED_PROJECT, MAYA2C_REPO, MAYA2C_SITE, PROJECTS } from '../data/content';
const f = FEATURED_PROJECT;
// Live network view: the four validators on a ring around the core. Every
// real block (polled from rpc.maya2c.dev) sends a pulse ring outward; the
// numbers under it are the chain's own. Without data it says "offline".
const VALIDATORS = [0, 1, 2, 3].map((i) => {
  const a = (i / 4) * Math.PI * 2 - Math.PI / 4;
  return { x: +(200 + Math.cos(a) * 92).toFixed(1), y: +(130 + Math.sin(a) * 92).toFixed(1) };
});
---

<section id="projects" aria-labelledby="projects-title">
  <div class="wrap">
    <p class="section-label" data-reveal>02 / portfolio</p>
    <h2 class="section-title" id="projects-title" data-reveal>What I'm building</h2>

    <div class="project-grid" data-reveal>
      <article class="card featured">
        <div>
          <p class="card-badge">{f.badge}</p>
          <h3 class="card-name">{f.name}</h3>
          <p class="card-desc">{f.description}</p>
          <ul class="tags">
            {f.tags.map((t) => <li>{t}</li>)}
          </ul>
          <dl class="spec">
            {f.spec.map(([k, v]) => (
              <div class="spec-row">
                <dt>{k}</dt>
                <dd>{v}</dd>
              </div>
            ))}
          </dl>
          <div class="card-links">
            {f.links.map((l) => (
              <a href={l.href} rel="noopener noreferrer" target="_blank">{l.label} <span aria-hidden="true">↗</span><span class="visually-hidden"> (opens in a new tab)</span></a>
            ))}
          </div>
        </div>
        <figure class="netview" aria-label="Maya2C testnet, live: validators, blocks and finality">
          <svg viewBox="0 0 400 260" role="img" aria-hidden="true" focusable="false">
            <defs>
              <radialGradient id="nv-core"><stop offset="0" stop-color="#e9fdff" /><stop offset=".35" stop-color="#3fd2e0" stop-opacity=".8" /><stop offset="1" stop-color="#1fb5c2" stop-opacity="0" /></radialGradient>
            </defs>
            <circle class="nv-orbit" cx="200" cy="130" r="92" />
            <circle class="nv-orbit faint" cx="200" cy="130" r="122" />
            {VALIDATORS.map((v, i) => VALIDATORS.slice(i + 1).map((w) => <line class="nv-link" x1={v.x} y1={v.y} x2={w.x} y2={w.y} />))}
            {VALIDATORS.map((v) => <line class="nv-spoke" x1="200" y1="130" x2={v.x} y2={v.y} />)}
            <g id="nv-pulses"></g>
            <circle cx="200" cy="130" r="34" fill="url(#nv-core)" class="core" />
            {VALIDATORS.map((v, i) => (
              <g class="validator" style={`--d:${i * 0.4}s`}>
                <circle cx={v.x} cy={v.y} r="11" class="halo" />
                <circle cx={v.x} cy={v.y} r="4.5" class="dot" />
              </g>
            ))}
          </svg>
          <figcaption class="nv-stats">
            <span><b id="nv-height">—</b> height</span>
            <span><b id="nv-bt">—</b> block time</span>
            <span><b>3 of 4</b> to finalize</span>
            <span class="nv-live" id="nv-state">connecting…</span>
          </figcaption>
        </figure>
      </article>
    </div>

    <div class="project-grid other-projects" data-reveal>
      {
        PROJECTS.map((p) => (
          <article class="card">
            <p class="card-badge">{p.badge}</p>
            <h3 class="card-name">{p.name}</h3>
            <p class="card-desc">{p.description}</p>
            <ul class="tags">
              {p.tags.map((t) => <li>{t}</li>)}
            </ul>
            {p.href ? (
              <div class="card-links">
                <a href={p.href} rel="noopener noreferrer" target="_blank">
                  View on GitHub <span aria-hidden="true">↗</span><span class="visually-hidden"> (opens in a new tab)</span>
                </a>
              </div>
            ) : (
              <p class="card-desc">Private repository.</p>
            )}
          </article>
        ))
      }
    </div>

    <ul class="card-desc source-links" data-reveal>
      <li>Maya2C source: <a class="tap-link" href={MAYA2C_REPO} rel="noopener noreferrer" target="_blank">github.com/EricWijesinghe/Maya2C <span class="visually-hidden">(opens in a new tab)</span></a></li>
      <li>Live site: <a class="tap-link" href={MAYA2C_SITE} rel="noopener noreferrer" target="_blank">maya2c.dev <span class="visually-hidden">(opens in a new tab)</span></a></li>
    </ul>
  </div>
</section>

<script>
  // Polls the public gateway; each new height pulses the core once.
  const RPC = "https://rpc.maya2c.dev/rpc";
  const pulses = document.getElementById("nv-pulses");
  const heightEl = document.getElementById("nv-height");
  const btEl = document.getElementById("nv-bt");
  const stateEl = document.getElementById("nv-state");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  let last = 0, lastAt = 0;
  const gaps: number[] = [];
  function pulse() {
    if (reduce || !pulses) return;
    const c = document.createElementNS("http://www.w3.org/2000/svg", "circle");
    c.setAttribute("cx", "200"); c.setAttribute("cy", "130"); c.setAttribute("r", "34");
    c.setAttribute("class", "pulse");
    pulses.appendChild(c);
    setTimeout(() => c.remove(), 2600);
  }
  async function tick() {
    try {
      const r = await fetch(RPC, { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ jsonrpc: "2.0", id: 1, method: "get_chain_info", params: [] }) });
      const h = ((await r.json()).result ?? {}).height as number;
      if (typeof h !== "number") throw new Error("no height");
      const now = performance.now();
      if (last && h > last) {
        gaps.push((now - lastAt) / (h - last)); if (gaps.length > 12) gaps.shift();
        btEl!.textContent = (gaps.reduce((a, b) => a + b, 0) / gaps.length / 1000).toFixed(1) + " s";
        pulse();
      }
      if (h !== last) { last = h; lastAt = now; }
      heightEl!.textContent = h.toLocaleString("en-US");
      stateEl!.textContent = "live"; stateEl!.classList.add("on");
    } catch {
      stateEl!.textContent = "offline"; stateEl!.classList.remove("on");
    }
  }
  tick(); setInterval(tick, 2000);
</script>
