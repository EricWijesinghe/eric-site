---
import { FEATURED_PROJECT as f, PROJECTS } from '../data/content';
import { ACTS, BENCH, STRUCTURE_ONLY } from '../data/scenes';
import '../styles/projects.css';

// Page order: the Maya2C stage, the UNICRON stage, then one bench holding both focus areas.
const [unicron, research, ai] = PROJECTS;
const FACTS = { maya: f, unicron } as const;
const BENCH_ITEMS = [
  { p: research, s: BENCH.research, id: 'research' },
  { p: ai, s: BENCH.ai, id: 'ai' },
];
// Both focus areas carry the same note today: it is printed once, under the label, instead of twice.
const sharedNote = research.note === ai.note ? research.note : null;
---

<section id="projects" class="projects" aria-labelledby="projects-title">
  <div class="wrap">
    <header class="projects-head">
      <p class="section-label" data-reveal><span>02</span> portfolio</p>
      <h2 class="section-title" id="projects-title" data-reveal>What I'm building</h2>
    </header>

    {ACTS.map((a, i) => {
      const p = FACTS[a.key];
      return (
        <article class="act" data-reveal aria-labelledby={`act-${a.key}`}>
          <div class="act-lockup">
            <div class="act-id">
              <p class="act-index"><span>{`0${i + 1}`}</span> {p.badge}</p>
              <h3 class="act-name" id={`act-${a.key}`}>{p.name}</h3>
            </div>
            <p class="act-desc">{p.description}</p>
          </div>

          <!-- The stage: the canvas host and its tag are siblings, so pointer capture on the host never eats a control. -->
          <div class="stage" role="group" aria-label={p.name} aria-describedby={`stage-${a.key}-d`} data-live="false">
            <p class="visually-hidden" id={`stage-${a.key}-d`}>{a.aria}</p>
            <div class="stage-view" data-scene={a.scene}></div>
            <p class="stage-inspect" aria-live="polite" data-hint={a.hint}>{a.hint}</p>
            <p class="stage-tag">
              {a.tag === 'live'
                ? (<><span class="tag-live">live readout</span><span class="tag-structure">{STRUCTURE_ONLY}</span></>)
                : (<span class="tag-illustration">illustration</span>)}
            </p>
          </div>

          <div class="explainer">
            <div class="explainer-text">
              <p class="explainer-line">{a.caption}</p>
              {a.formula && <p class="explainer-formula">{a.formula}</p>}
            </div>
            <button type="button" class="scene-act">{a.act}</button>
          </div>

          {a.key === 'maya' && (
            <div class="facts">
              <dl class="facts-spec">
                {f.spec.map(([k, v]) => (
                  <div class="facts-pair"><dt>{k}</dt><dd>{v}</dd></div>
                ))}
              </dl>
              <div class="facts-net" id="netview">
                <p class="facts-pair nv-num"><span class="facts-k">height</span> <b id="nv-height">—</b></p>
                <p class="facts-pair nv-num"><span class="facts-k">block time</span> <b id="nv-bt">—</b></p>
                <p class="facts-pair"><span class="facts-k">state</span> <span id="nv-state" class="nv-live" role="status">connecting…</span></p>
              </div>
              <p class="facts-disclosure">{f.disclosure}</p>
              <div class="facts-links">
                {f.links.map((l) => (
                  <a href={l.href} rel="noopener noreferrer" target="_blank">{l.label} <span aria-hidden="true">↗</span><span class="visually-hidden"> (opens in a new tab)</span></a>
                ))}
              </div>
            </div>
          )}
        </article>
      );
    })}

    <!-- The bench: both focus areas side by side. Neither is a shipped product, and each scene says so. -->
    <div class="bench" data-reveal>
      <p class="bench-label">focus areas</p>
      {sharedNote && <p class="bench-note bench-shared">{sharedNote}</p>}
      <div class="bench-grid">
        {BENCH_ITEMS.map(({ p, s, id }) => (
          <figure class="bench-item" aria-labelledby={`bench-${id}`}>
            <div class="bench-lockup">
              <p class="act-index">{p.badge}</p>
              <h3 class="bench-name" id={`bench-${id}`}>{p.name}</h3>
              <p class="bench-desc">{p.description}</p>
              <p class="bench-tags">{p.tags.join(' · ')}</p>
              {!sharedNote && <p class="bench-note">{p.note}</p>}
            </div>
            <div class="bench-view" data-scene={s.scene} role="img" aria-label={s.aria}></div>
            <div class="scene-bar">
              <button type="button" class="scene-act">{s.act}</button>
              <span class="scene-badge">illustration</span>
            </div>
          </figure>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import { startChainPoll } from '../scripts/scene-chain';
  import { mountMaya } from '../scripts/scene-maya';
  import { mountNeural } from '../scripts/scene-neural';
  import { mountFuzz } from '../scripts/scene-fuzz';
  import { mountUnicron } from '../scripts/scene-unicron';

  const MOUNTS: Record<string, (host: HTMLElement) => void> = {
    maya: mountMaya,
    unicron: mountUnicron,
    fuzz: mountFuzz,
    neural: mountNeural,
  };
  document.querySelectorAll<HTMLElement>('[data-scene]').forEach((el) => {
    MOUNTS[el.dataset.scene ?? '']?.(el);
  });
  startChainPoll();
</script>
