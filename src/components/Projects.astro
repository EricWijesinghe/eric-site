---
import { FEATURED_PROJECT as f, PROJECTS } from '../data/content';
import { CHAPTERS, STRUCTURE_ONLY } from '../data/scenes';
import '../styles/projects.css';

// Order of the chapters on the page: Maya2C first, then the three focus areas.
const [unicron, research, ai] = PROJECTS;
---

<section id="projects" class="projects" aria-labelledby="projects-title">
  <div class="wrap">
    <header class="projects-head">
      <p class="section-label" data-reveal><span>02</span> portfolio</p>
      <h2 class="section-title" id="projects-title" data-reveal>What I'm building</h2>
    </header>

    <!-- Chapter 01: Maya2C. The live readout is the chain's own numbers, or nothing. -->
    <article class="chapter" data-reveal>
      <figure class="chapter-scene" data-live="false">
        <div class="sig-viewport scene" data-scene={CHAPTERS.maya.scene} role="img" aria-label={CHAPTERS.maya.aria}></div>
        <div class="scene-bar">
          <button type="button" class="scene-act">{CHAPTERS.maya.act}</button>
          <span class="scene-badge"><span class="tag-live">live readout</span><span class="tag-structure">{STRUCTURE_ONLY}</span></span>
        </div>
        <figcaption class="scene-caption">{CHAPTERS.maya.caption}</figcaption>
        <div class="hud" id="netview">
          <p class="hud-row nv-num"><span class="hud-k">height</span> <b id="nv-height">—</b></p>
          <p class="hud-row nv-num"><span class="hud-k">block time</span> <b id="nv-bt">—</b></p>
          <p class="hud-row"><span class="hud-k">finality</span> <b>DAG-BFT</b></p>
          <p class="hud-row"><span class="hud-k">state</span> <span id="nv-state" class="nv-live" role="status">connecting…</span></p>
        </div>
      </figure>
      <div class="chapter-text">
        <p class="chapter-index"><span>01</span> {f.badge}</p>
        <h3 class="chapter-name">{f.name}</h3>
        <p class="chapter-desc">{f.description}</p>
        <ul class="chapter-tags">
          {f.tags.map((t) => <li>{t}</li>)}
        </ul>
        <dl class="chapter-spec">
          {f.spec.map(([k, v]) => (
            <div class="spec-cell">
              <dt>{k}</dt>
              <dd>{v}</dd>
            </div>
          ))}
        </dl>
        <p class="chapter-disclosure">{f.disclosure}</p>
        <div class="chapter-links">
          {f.links.map((l) => (
            <a href={l.href} rel="noopener noreferrer" target="_blank">{l.label} <span aria-hidden="true">↗</span><span class="visually-hidden"> (opens in a new tab)</span></a>
          ))}
        </div>
      </div>
    </article>

    <!-- Chapter 02: UNICRON, described only. Its scene is an illustration. -->
    <article class="chapter flip" data-reveal>
      <figure class="chapter-scene">
        <div class="sig-viewport scene" data-scene={CHAPTERS.unicron.scene} role="img" aria-label={CHAPTERS.unicron.aria}></div>
        <div class="scene-bar">
          <button type="button" class="scene-act">{CHAPTERS.unicron.act}</button>
          <span class="scene-badge"><span class="tag-illustration">illustration</span></span>
        </div>
        <figcaption class="scene-caption">{CHAPTERS.unicron.caption}</figcaption>
      </figure>
      <div class="chapter-text">
        <p class="chapter-index"><span>02</span> {unicron.badge}</p>
        <h3 class="chapter-name">{unicron.name}</h3>
        <p class="chapter-desc">{unicron.description}</p>
        <ul class="chapter-tags">
          {unicron.tags.map((t) => <li>{t}</li>)}
        </ul>
        <p class="chapter-note">{unicron.note}</p>
      </div>
    </article>

    <!-- Chapter 03: security research. A focus area, not a shipped product. -->
    <article class="chapter" data-reveal>
      <figure class="chapter-scene">
        <div class="sig-viewport scene" data-scene={CHAPTERS.research.scene} role="img" aria-label={CHAPTERS.research.aria}></div>
        <div class="scene-bar">
          <button type="button" class="scene-act">{CHAPTERS.research.act}</button>
          <span class="scene-badge"><span class="tag-illustration">illustration</span></span>
        </div>
        <figcaption class="scene-caption">{CHAPTERS.research.caption}</figcaption>
      </figure>
      <div class="chapter-text">
        <p class="chapter-index"><span>03</span> {research.badge}</p>
        <h3 class="chapter-name">{research.name}</h3>
        <p class="chapter-desc">{research.description}</p>
        <ul class="chapter-tags">
          {research.tags.map((t) => <li>{t}</li>)}
        </ul>
        <p class="chapter-note">{research.note}</p>
      </div>
    </article>

    <!-- Chapter 04: AI x Security. A focus area, not a shipped product. -->
    <article class="chapter flip" data-reveal>
      <figure class="chapter-scene">
        <div class="sig-viewport scene" data-scene={CHAPTERS.ai.scene} role="img" aria-label={CHAPTERS.ai.aria}></div>
        <div class="scene-bar">
          <button type="button" class="scene-act">{CHAPTERS.ai.act}</button>
          <span class="scene-badge"><span class="tag-illustration">illustration</span></span>
        </div>
        <figcaption class="scene-caption">{CHAPTERS.ai.caption}</figcaption>
      </figure>
      <div class="chapter-text">
        <p class="chapter-index"><span>04</span> {ai.badge}</p>
        <h3 class="chapter-name">{ai.name}</h3>
        <p class="chapter-desc">{ai.description}</p>
        <ul class="chapter-tags">
          {ai.tags.map((t) => <li>{t}</li>)}
        </ul>
        <p class="chapter-note">{ai.note}</p>
      </div>
    </article>
  </div>
</section>

<script>
  import { startChainPoll } from '../scripts/scene-chain';
  import { mountMaya } from '../scripts/scene-maya';
  import { mountNeural } from '../scripts/scene-neural';
  import { mountFuzz } from '../scripts/scene-fuzz';
  import { mountUnicron } from '../scripts/scene-unicron';

  const MOUNTS: Record<string, (host: HTMLElement) => void> = {
    maya: mountMaya,
    unicron: mountUnicron,
    fuzz: mountFuzz,
    neural: mountNeural,
  };
  document.querySelectorAll<HTMLElement>('[data-scene]').forEach((el) => {
    MOUNTS[el.dataset.scene ?? '']?.(el);
  });
  startChainPoll();
</script>
