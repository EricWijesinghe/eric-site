---
// Brand glyphs come from simple-icons at build time, so no icon font or CDN is needed.
// simple-icons dropped its LinkedIn glyph, so that one is an inline "in" mark.
import { siFacebook, siGithub, siInstagram } from 'simple-icons';

interface Props {
  name: 'github' | 'linkedin' | 'facebook' | 'instagram';
}

const LINKEDIN_PATH =
  'M3 8.5h4.2V21H3zM5.1 2.5a2.4 2.4 0 1 1 0 4.8 2.4 2.4 0 0 1 0-4.8zM9.6 8.5h4v1.7h.1c.6-1.1 1.9-2.2 3.9-2.2 4.2 0 5 2.7 5 6.3V21h-4.2v-5.9c0-1.4 0-3.2-2-3.2s-2.3 1.5-2.3 3.1V21H9.6z';
const paths = {
  github: siGithub.path,
  linkedin: LINKEDIN_PATH,
  facebook: siFacebook.path,
  instagram: siInstagram.path,
};
const { name } = Astro.props;
---

<svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={paths[name]} fill="currentColor" /></svg>
