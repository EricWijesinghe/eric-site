---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import SingularityHero from '../components/SingularityHero.astro';
import Conduit from '../components/Conduit.astro';
import About from '../components/About.astro';
import Projects from '../components/Projects.astro';
import Skills from '../components/Skills.astro';
import Support from '../components/Support.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import EnergyOverlay from '../components/EnergyOverlay.astro';
---

<Base>
  <!-- The hero figure is the LCP-adjacent image: start its fetch with the HTML, not after the idle hero boot. -->
  <link slot="head" rel="preload" as="image" href="/eric/eric-v11-figure.webp" fetchpriority="high" />
  <Nav />
  <EnergyOverlay />
  <main id="main">
    <!-- One continuous page: the singularity is the source, and the conduit carries its energy
         down through every section (Conduit.astro). No dividers between sections. -->
    <SingularityHero />
    <Conduit />
    <About />
    <Projects />
    <Skills />
    <Support />
    <Contact />
  </main>
  <Footer />
</Base>
