---
import Base from '../layouts/Base.astro';
---

<Base noindex title="Page not found — Eric Wijesinghe" description="This page does not exist on eric.maya2c.dev.">
  <main id="main" class="not-found">
    <div class="wrap">
      <p class="section-label"><span>404</span> not found</p>
      <h1 class="section-title">This page does not exist.</h1>
      <p class="card-desc">The link may be old, or mistyped. Everything on this site is on the home page.</p>
      <p><a class="btn btn-primary" href="/">Back to the home page</a></p>
    </div>
  </main>
</Base>
