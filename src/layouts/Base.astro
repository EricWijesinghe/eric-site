---
import '@fontsource/manrope/latin-600.css';
import '@fontsource/manrope/latin-800.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '../styles/global.css';
import { SITE_DESCRIPTION, SITE_TITLE, SITE_URL } from '../data/content';

const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const personLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Eric Wijesinghe',
  url: SITE_URL,
  sameAs: [
    'https://github.com/EricWijesinghe',
    'https://www.linkedin.com/in/ericwijesinghe',
    'https://www.facebook.com/EricWijesinghe2002/',
    'https://www.instagram.com/ericwijesinghe2022/',
  ],
  jobTitle: 'Rust-First Engineer',
  knowsAbout: ['Rust', 'Post-quantum cryptography', 'Security research', 'Blockchain'],
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{SITE_TITLE}</title>
    <meta name="description" content={SITE_DESCRIPTION} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#050b0f" />
    <meta name="color-scheme" content="dark" />
    <meta name="robots" content="index,follow" />
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="Eric Wijesinghe" />
    <meta property="og:title" content={SITE_TITLE} />
    <meta property="og:description" content={SITE_DESCRIPTION} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${SITE_URL}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={SITE_TITLE} />
    <meta name="twitter:description" content={SITE_DESCRIPTION} />
    <meta name="twitter:image" content={`${SITE_URL}/og.png`} />
    <script type="application/ld+json" set:html={personLd} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="bg-css" aria-hidden="true">
      <span class="blob blob-a"></span>
      <span class="blob blob-b"></span>
      <span class="blob blob-c"></span>
      <span class="mesh"></span>
    </div>
    <canvas class="bg-canvas" data-bg aria-hidden="true"></canvas>
    <slot />
    <script>
      import '../scripts/bg';
      import '../scripts/reveal';
      import '../scripts/tilt';
    </script>
  </body>
</html>
