---
import '@fontsource/manrope/latin-600.css';
import '@fontsource/manrope/latin-800.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '../styles/global.css';
import '../styles/sections.css';
import { MAYA2C_SITE, OG_IMAGE_ALT, SITE_DESCRIPTION, SITE_TITLE, SITE_URL, SOCIALS } from '../data/content';

// noindex: the 404 page renders through this layout too and must stay out of search.
const { noindex = false } = Astro.props as { noindex?: boolean };
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const PERSON_ID = `${SITE_URL}/#person`;
// One @graph: the WebSite points at the Person through @id. "<" is escaped so no value can close the script tag.
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': PERSON_ID,
      name: 'Eric Wijesinghe',
      url: SITE_URL,
      sameAs: [...SOCIALS.map((x) => x.href), MAYA2C_SITE],
      jobTitle: 'Rust-First Engineer',
      knowsAbout: ['Rust', 'Post-quantum cryptography', 'Security research', 'Blockchain'],
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE_URL}/#website`,
      url: SITE_URL,
      name: 'Eric Wijesinghe',
      inLanguage: 'en',
      publisher: { '@id': PERSON_ID },
    },
  ],
}).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{SITE_TITLE}</title>
    <meta name="description" content={SITE_DESCRIPTION} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#02050b" />
    <meta name="color-scheme" content="dark light" />
    <script is:inline src="/theme-init.js"></script>
    <meta name="robots" content={noindex ? 'noindex' : 'index,follow'} />
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="Eric Wijesinghe" />
    <meta property="og:title" content={SITE_TITLE} />
    <meta property="og:description" content={SITE_DESCRIPTION} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={`${SITE_URL}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={OG_IMAGE_ALT} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={SITE_TITLE} />
    <meta name="twitter:description" content={SITE_DESCRIPTION} />
    <meta name="twitter:image" content={`${SITE_URL}/og.png`} />
    <meta name="twitter:image:alt" content={OG_IMAGE_ALT} />
    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="grain" aria-hidden="true"></div>
    <slot />
    <script>
      import '../scripts/theme';
      import '../scripts/reveal';
      import '../scripts/tilt';
      import '../scripts/skills';
      import '../scripts/gl/boot';
    </script>
  </body>
</html>
